# Local dev: reads library.db from parent directory
# Production: set these to your Turso database
TURSO_DATABASE_URL=file:../library.db
TURSO_AUTH_TOKEN=

# Spotify OAuth (same creds as CLI tools)
SPOTIFY_CLIENT_ID=7186b73b1b4a48949e0990e8ed499f0e
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# For production, set SPOTIFY_REDIRECT_URI to your Vercel URL:
# SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
